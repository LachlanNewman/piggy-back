# OIDC provider base URL (e.g. https://accounts.google.com or https://your-tenant.okta.com/oauth2/default)
VITE_OIDC_AUTHORITY=

# Client ID registered with your OIDC provider
VITE_OIDC_CLIENT_ID=

# Redirect URI — must match exactly what is registered with your OIDC provider
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

# Base URL of the backend API. Leave empty for local dev — Vite proxies /api to
# the backend. Set to the backend's public URL when the frontend is deployed
# separately (e.g. https://piggy-back-97mj.onrender.com). Read at build time.
VITE_API_BASE_URL=
