# OIDC provider base URL (Keycloak realm issuer, or e.g. https://accounts.google.com)
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8180/realms/piggyback

# Client ID registered with your OIDC provider
NEXT_PUBLIC_OIDC_CLIENT_ID=piggyback-frontend

# Redirect URI — must match exactly what is registered with your OIDC provider
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/callback

# Where the Next server proxies /api/* requests (server-side only)
BACKEND_URL=http://localhost:8080
